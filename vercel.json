{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "routes": [
    { "src": "/api(?:/.*)?", "dest": "/api/index" },
    { "src": "/uploads(?:/.*)?", "dest": "/api/index" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
